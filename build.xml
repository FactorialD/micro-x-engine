<?xml version="1.0" encoding="UTF-8"?>
<project name="micro-x-engine" default="package" basedir=".">
  <property file="build.properties"/>

  <path id="midp.bootclasspath">
    <pathelement location="${cldc.jar}"/>
    <pathelement location="${midp.jar}"/>
  </path>

  <target name="clean" description="Remove all generated output">
    <delete dir="${build.dir}"/>
    <delete file="${dist.jar}"/>
    <delete file="${dist.jad}"/>
  </target>

  <target name="check-toolchain" description="Fail early unless the configured compiler can emit CLDC-compatible bytecode">
    <available file="${j2me.javac}" property="j2me.javac.available"/>
    <fail unless="j2me.javac.available"
          message="No compatible J2ME compiler at ${j2me.javac}. Set toolchain.jdk.home to JDK 6/7; modern javac cannot emit -source/-target 1.3 bytecode."/>
    <available file="${cldc.jar}" property="cldc.jar.available"/>
    <available file="${midp.jar}" property="midp.jar.available"/>
    <available file="${preverify}" property="preverify.available"/>
    <fail unless="cldc.jar.available" message="Missing CLDC API: ${cldc.jar}. Configure wtk.home in build.properties."/>
    <fail unless="midp.jar.available" message="Missing MIDP API: ${midp.jar}. Configure wtk.home in build.properties."/>
    <fail unless="preverify.available" message="Missing WTK preverify: ${preverify}. Configure wtk.home in build.properties."/>
    <mkdir dir="${build.dir}/toolchain-check"/>
    <echo file="${build.dir}/toolchain-check/ClDcProbe.java">final class ClDcProbe {}</echo>
    <exec executable="${j2me.javac}" failonerror="true"
          error="${build.dir}/toolchain-check/javac.err">
      <arg value="-source"/><arg value="1.3"/>
      <arg value="-target"/><arg value="1.3"/>
      <arg value="-d"/><arg value="${build.dir}/toolchain-check"/>
      <arg value="${build.dir}/toolchain-check/ClDcProbe.java"/>
    </exec>
  </target>

  <target name="compile-tools" description="Compile desktop-only asset conversion tools">
    <mkdir dir="${tools.classes.dir}"/>
    <javac srcdir="${tools.src.dir}" destdir="${tools.classes.dir}"
           source="8" target="8" includeantruntime="false" debug="false"/>
  </target>

  <target name="desktop-test" depends="compile-tools,convert-assets,copy-gameplay-resources" description="Run converter, binary loader, collision and fixed math tests on the host JDK">
    <delete dir="${desktop.test.classes.dir}"/>
    <mkdir dir="${desktop.test.classes.dir}"/>
    <javac destdir="${desktop.test.classes.dir}" source="8" target="8"
           includeantruntime="false" debug="true">
      <src path="src"/><src path="tools/src"/><src path="test"/>
      <include name="com/microx/engine/math/**"/>
      <include name="com/microx/engine/world/**"/>
      <include name="com/microx/engine/combat/**"/>
      <include name="com/microx/engine/gameplay/**"/>
      <include name="com/microx/engine/Input.java"/>
      <include name="com/microx/engine/Telemetry.java"/>
      <include name="com/microx/engine/ui/UIStateMachine.java"/>
      <include name="com/microx/engine/ui/UISettings.java"/>
      <include name="com/microx/tools/AssetConverter.java"/>
      <include name="com/microx/tools/GameplayDataTest.java"/>
      <include name="com/microx/tools/LocationPackageTest.java"/>
      <include name="com/microx/engine/assets/AssetManager.java"/>
      <include name="com/microx/engine/assets/MeshSection.java"/>
      <include name="com/microx/engine/assets/GeometryLoader.java"/>
      <include name="com/microx/engine/assets/TextureData.java"/>
      <include name="com/microx/engine/render/Clipper.java"/>
      <include name="com/microx/engine/render/Rasterizer.java"/>
      <include name="com/microx/engine/render/RenderingTest.java"/>
      <include name="com/microx/engine/save/SaveData.java"/>
      <include name="com/microx/engine/save/SaveException.java"/>
      <include name="com/microx/engine/save/SaveCodec.java"/>
      <include name="com/microx/engine/save/RecordBackend.java"/>
      <include name="com/microx/engine/save/SaveStore.java"/>
      <include name="com/microx/engine/save/SaveStoreTest.java"/>
    </javac>
    <java classname="com.microx.engine.math.FixedMathTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/><pathelement location="${resources.stage.dir}"/></classpath>
    </java>
    <java classname="com.microx.engine.world.WorldFormatTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/></classpath>
    </java>
    <java classname="com.microx.engine.render.RenderingTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/></classpath>
    </java>
    <java classname="com.microx.engine.world.SimulationTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/></classpath>
    </java>
    <java classname="com.microx.engine.combat.CombatTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/><pathelement location="${resources.stage.dir}"/></classpath>
    </java>
    <java classname="com.microx.engine.InputTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/><pathelement location="${resources.stage.dir}"/></classpath>
    </java>
    <java classname="com.microx.engine.gameplay.GameplayTest" fork="true" failonerror="true"><classpath><pathelement location="${desktop.test.classes.dir}"/><pathelement location="${resources.stage.dir}"/></classpath></java>
    <java classname="com.microx.tools.GameplayDataTest" fork="true" failonerror="true"><classpath><pathelement location="${desktop.test.classes.dir}"/><pathelement location="${resources.stage.dir}"/></classpath></java>
    <java classname="com.microx.tools.LocationPackageTest" fork="true" failonerror="true">
      <classpath><pathelement location="${desktop.test.classes.dir}"/></classpath>
      <arg value="${basedir}"/><arg value="${generated.resources.dir}"/>
    </java>
    <java classname="com.microx.engine.ui.UIStateMachineTest" fork="true" failonerror="true"><classpath><pathelement location="${desktop.test.classes.dir}"/></classpath></java>
    <java classname="com.microx.engine.save.SaveStoreTest" fork="true" failonerror="true"><classpath><pathelement location="${desktop.test.classes.dir}"/></classpath></java>
  </target>

  <target name="desktop-static-test" depends="desktop-test,check-level-contract" description="Run host-side static and persistence tests without MIDP packaging">
    <fail message="Java sources must not import editable assets from res">
      <condition><resourcecount when="greater" count="0"><fileset dir="src"><contains text="res/"/></fileset></resourcecount></condition>
    </fail>
  </target>

  <target name="check-level-contract" description="Reject obsolete level filenames and references">
    <exec executable="sh" failonerror="true">
      <arg value="tools/check-level-contract.sh"/>
    </exec>
  </target>

  <target name="check-data-extensions" description="Reject obsolete editable gameplay .data files">
    <fail message="res/data contains obsolete .data files; gameplay tables must use .txt">
      <condition><resourcecount when="greater" count="0"><fileset dir="res/data" includes="**/*.data"/></resourcecount></condition>
    </fail>
  </target>

  <target name="python-sdk-test" description="Run the desktop editor unit tests without packaging it">
    <exec executable="python3" dir="sdk/python/microx_editor" failonerror="true">
      <arg value="-m"/><arg value="unittest"/><arg value="discover"/><arg value="-s"/><arg value="tests"/><arg value="-v"/>
    </exec>
  </target>

  <target name="ci" depends="desktop-static-test,check-data-extensions,python-sdk-test" description="Run host Java, editor and asset-policy checks"/>

  <target name="format-check" description="Check Java formatting without modifying source files">
    <apply executable="${clang.format}" failonerror="true" parallel="true">
      <arg value="--dry-run"/>
      <arg value="--Werror"/>
      <fileset dir="src" includes="**/*.java"/>
      <fileset dir="test" includes="**/*.java"/>
      <fileset dir="tools/src" includes="**/*.java"/>
    </apply>
  </target>

  <target name="convert-assets" depends="compile-tools,check-level-contract" description="Validate/copy text levels and validate and stage textual runtime geometry">
    <delete dir="${generated.resources.dir}"/>
    <mkdir dir="${generated.resources.dir}"/>
    <java classname="com.microx.tools.AssetConverter" fork="true" failonerror="true">
      <classpath><pathelement location="${tools.classes.dir}"/></classpath>
      <arg value="${assets.source.dir}"/>
      <arg value="${generated.resources.dir}"/>
    </java>
  </target>

  <target name="copy-gameplay-resources" description="Stage the UTF-8 gameplay tables at their absolute runtime classpath paths">
    <fail message="GameplayTables.DEFAULT_RESOURCE and gameplay.registry.resource must be the same absolute classpath path">
      <condition><resourcecount when="equal" count="0"><fileset dir="src/com/microx/engine/gameplay" includes="GameplayTables.java"><contains text="DEFAULT_RESOURCE = &quot;${gameplay.registry.resource}&quot;"/></fileset></resourcecount></condition>
    </fail>
    <mkdir dir="${resources.stage.dir}/data"/>
    <copy todir="${resources.stage.dir}/data"><fileset dir="res/data" includes="**/*.txt"/></copy>
    <fail message="Missing ${gameplay.registry.resource}; GameplayTables.getResourceAsStream would fail at runtime">
      <condition><not><available file="${resources.stage.dir}${gameplay.registry.resource}"/></not></condition>
    </fail>
  </target>

  <target name="copy-runtime-resources" depends="convert-assets,copy-gameplay-resources" description="Stage generated, gameplay, and explicitly runtime-only resources">
    <mkdir dir="${resources.stage.dir}"/>
    <copy todir="${resources.stage.dir}">
      <fileset dir="${generated.resources.dir}"/>
    </copy>
    <copy todir="${resources.stage.dir}" failonerror="false">
      <fileset dir="${runtime.resources.dir}"/>
    </copy>
  </target>

  <target name="compile" depends="check-toolchain" description="Compile MIDP application with the pinned legacy JDK">
    <mkdir dir="${classes.dir}"/>
    <javac srcdir="src" destdir="${classes.dir}" source="1.3" target="1.3"
           bootclasspathref="midp.bootclasspath" includeantruntime="false"
           debug="${debug}" fork="true" executable="${j2me.javac}"/>
  </target>

  <target name="preverify" depends="compile" description="Preverify application classes for CLDC 1.1">
    <mkdir dir="${verified.dir}"/>
    <exec executable="${preverify}" failonerror="true">
      <arg value="-classpath"/><arg pathref="midp.bootclasspath"/>
      <arg value="-d"/><arg value="${verified.dir}"/>
      <arg value="${classes.dir}"/>
    </exec>
  </target>

  <target name="create-jar" depends="preverify,copy-runtime-resources" description="Create the deployable MIDlet JAR">
    <jar destfile="${dist.jar}" manifest="MANIFEST.MF">
      <fileset dir="${verified.dir}"/>
      <fileset dir="${resources.stage.dir}"/>
    </jar>
  </target>

  <target name="validate-package" depends="create-jar" description="Check every authored location and validate all required runtime resources in the JAR">
    <exec executable="sh" failonerror="true">
      <arg value="tools/check-packaged-levels.sh"/><arg value="${dist.jar}"/>
    </exec>
    <fail message="Mandatory Cordon runtime resources are missing from the JAR"><condition><not><resourcecount when="equal" count="2"><zipfileset src="${dist.jar}" includes="levels/cordon/level.txt,levels/cordon/geometry.txt"/></resourcecount></not></condition></fail>
    <fail message="Mandatory Garbage runtime resources are missing from the JAR"><condition><not><resourcecount when="equal" count="2"><zipfileset src="${dist.jar}" includes="levels/garbage/level.txt,levels/garbage/geometry.txt"/></resourcecount></not></condition></fail>
    <fail message="Story location runtime resources are missing from the JAR"><condition><not><resourcecount when="equal" count="22"><zipfileset src="${dist.jar}" includes="levels/depot/level.txt,levels/depot/geometry.txt,levels/laboratory/level.txt,levels/laboratory/geometry.txt,levels/arena/level.txt,levels/arena/geometry.txt,levels/agroprom/level.txt,levels/agroprom/geometry.txt,levels/bar/level.txt,levels/bar/geometry.txt,levels/wild_territory/level.txt,levels/wild_territory/geometry.txt,levels/yantar/level.txt,levels/yantar/geometry.txt,levels/army_warehouses/level.txt,levels/army_warehouses/geometry.txt,levels/radar/level.txt,levels/radar/geometry.txt,levels/pripyat/level.txt,levels/pripyat/geometry.txt,levels/cnpp/level.txt,levels/cnpp/geometry.txt"/></resourcecount></not></condition></fail>
    <fail message="Debug test geometry is missing from the JAR"><condition><not><resourcecount when="equal" count="2"><zipfileset src="${dist.jar}" includes="test/cube/geometry.txt,test/pyramid/geometry.txt"/></resourcecount></not></condition></fail>
    <fail message="Mandatory ${gameplay.registry.resource} is missing from the JAR"><condition><not><resourcecount when="equal" count="1"><zipfileset src="${dist.jar}" includes="data/gameplay/gameplay.txt"/></resourcecount></not></condition></fail>
    <fail message="A registered /data/&lt;table&gt;/&lt;table&gt;.txt runtime resource is missing from the JAR"><condition><not><resourcecount when="equal" count="16"><zipfileset src="${dist.jar}" includes="data/*/*.txt"/></resourcecount></not></condition></fail>
    <fail message="Editor-only assets are forbidden in the runtime JAR"><condition><resourcecount when="greater" count="0"><zipfileset src="${dist.jar}" includes="**/*.obj,**/*~"/></resourcecount></condition></fail>
  </target>

  <target name="create-jad" depends="validate-package" description="Create a JAD matching the packaged JAR">
    <length file="${dist.jar}" property="jar.size"/>
    <copy file="MANIFEST.MF" tofile="${dist.jad}"/>
    <echo file="${dist.jad}" append="true">MIDlet-Jar-URL: ${dist.jar}${line.separator}MIDlet-Jar-Size: ${jar.size}${line.separator}</echo>
  </target>

  <target name="check-jar-size" depends="create-jad" description="Enforce the configured distribution size budget">
    <length file="${dist.jar}" property="jar.size.checked"/>
    <fail message="${dist.jar} is ${jar.size.checked} bytes; limit is ${max.jar.bytes} bytes.">
      <condition><greater arg1="${jar.size.checked}" arg2="${max.jar.bytes}" type="long"/></condition>
    </fail>
  </target>

  <target name="package" depends="check-jar-size" description="Convert assets, compile, preverify, and package JAR/JAD"/>
  <target name="jar" depends="package" description="Backward-compatible alias for package"/>
</project>
