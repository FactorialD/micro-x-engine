# Cordon: starting camp and northern road. Entity fields end with faction, sprite, aux.
MXL2
# rooms floors ceilings edges portals spawns transitions entities capacity
counts 1 1 1 3 1 2 1 4 12
room -8 8 -8 8
floor 0 -8 8 -8 8 0
ceiling 0 -8 8 -8 8 4
edge 0 -8 -8 8 -8 0 4
edge 0 -8 -8 -8 8 0 4
edge 0 8 -8 8 8 0 4
# The north opening is an inter-location portal; transition index 0 autosaves in Engine.
portal 100 0 0 -2 2 0 3 7 8 -1 0
# Spawn 10 is the reciprocal arrival requested by Garbage.
spawn 0 0 0 0 -4 0
spawn 10 0 0 0 5 180
transition 1000 20 garbage
# stable-id type x y z health faction sprite aux
entity 10001 1 -3 0 0 100 2 11 2
entity 10002 1 2 0 -2 100 1 12 1
entity 10003 7 4 0 3 1 0 17 4
